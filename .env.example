# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# Get your database URL from your PostgreSQL provider (Neon, Supabase, etc.)
# -----------------------------------------------------------------------------
DATABASE_URL='postgresql://user:password@host:port/database?sslmode=require'
# Optional: Override SSL mode (disable | require). Auto-detected based on hostname if not set.
# Useful for Docker/internal deployments where SSL is not needed.
# DATABASE_SSL_MODE=disable

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL='http://localhost:3000'
# Default billing provider (creem | stripe)
NEXT_PUBLIC_BILLING_PROVIDER="creem"

# -----------------------------------------------------------------------------
# Authentication (Better Auth)
# Generate a new secret with: openssl rand -base64 32
# -----------------------------------------------------------------------------
BETTER_AUTH_SECRET='your_better_auth_secret_here'

# Google OAuth (Get credentials from: https://console.cloud.google.com/)
GOOGLE_CLIENT_ID='your_google_client_id'
GOOGLE_CLIENT_SECRET='your_google_client_secret'

# -----------------------------------------------------------------------------
# Email (RESEND)
# Get your API key from: https://resend.com/api-keys
# -----------------------------------------------------------------------------
RESEND_API_KEY='re_your_resend_api_key'
RESEND_FROM='noreply@yourdomain.com'

# -----------------------------------------------------------------------------
# Subscriptions (Stripe) - Optional if using Creem
# -----------------------------------------------------------------------------
STRIPE_API_KEY="sk_test_your_stripe_api_key"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"
NEXT_PUBLIC_STRIPE_STD_PRODUCT_ID="prod_xxx"
NEXT_PUBLIC_STRIPE_STD_MONTHLY_PRICE_ID="price_xxx"

NEXT_PUBLIC_STRIPE_PRO_PRODUCT_ID="prod_xxx"
NEXT_PUBLIC_STRIPE_PRO_MONTHLY_PRICE_ID="price_xxx"
NEXT_PUBLIC_STRIPE_PRO_YEARLY_PRICE_ID="price_xxx"
NEXT_PUBLIC_STRIPE_BUSINESS_PRODUCT_ID="prod_xxx"
NEXT_PUBLIC_STRIPE_BUSINESS_MONTHLY_PRICE_ID="price_xxx"
NEXT_PUBLIC_STRIPE_BUSINESS_YEARLY_PRICE_ID="price_xxx"

# -----------------------------------------------------------------------------
# Creem (Default Billing)
# Get your API keys from: https://creem.io/dashboard
# -----------------------------------------------------------------------------
CREEM_API_KEY="creem_sk_your_api_key"
CREEM_WEBHOOK_SECRET="whsec_your_webhook_secret"

# -----------------------------------------------------------------------------
# Analytics (PostHog) - Optional
# -----------------------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY="your_posthog_key"
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# -----------------------------------------------------------------------------
# Analytics (Plausible) - Optional
# Self-hosted or cloud Plausible analytics
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=yourdomain.com
# NEXT_PUBLIC_PLAUSIBLE_SCRIPT=https://plausible.io/js/script.js

# -----------------------------------------------------------------------------
# Admin Account
# Set your email to automatically grant admin permissions
# -----------------------------------------------------------------------------
ADMIN_EMAIL="your-email@example.com"

# -----------------------------------------------------------------------------
# Debug Mode
# -----------------------------------------------------------------------------
IS_DEBUG=false

# Local UI editor (development only; production routes remain disabled)
UI_STUDIO_ENABLED=false
LOCAL_TEST_AUTH_ENABLED=false
# Optional for Windows local production QA without standalone symlink packaging:
# NEXT_LOCAL_BUILD=true

# -----------------------------------------------------------------------------
# R2/S3 Storage
# Get your credentials from Cloudflare R2 or AWS S3
# -----------------------------------------------------------------------------
STORAGE_ENDPOINT=https://xxx.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=your_r2_access_key_id
STORAGE_SECRET_KEY=your_r2_secret_access_key
STORAGE_BUCKET=your_bucket_name
STORAGE_DOMAIN=https://pub-xxx.r2.dev

# -----------------------------------------------------------------------------
# AI Video Providers
# Get your API keys from the respective providers
# -----------------------------------------------------------------------------
# Evolink: https://evolink.ai
EVOLINK_API_KEY=sk-your_evolink_api_key

# Kie.ai: https://kie.ai
KIE_API_KEY=your_kie_api_key

# APImart: https://apimart.ai (supports Seedance 1.0/1.5, Sora 2, Wan 2.6, Veo 3.1)
APIMART_API_KEY=your_apimart_api_key

# Default provider (evolink | kie | apimart)
# The app will only use models/modes supported by this provider.
# Unsupported models are filtered from the UI and rejected by the API instead of silently falling back.
DEFAULT_AI_PROVIDER=evolink

# -----------------------------------------------------------------------------
# AI Callback (REQUIRED for production)
# Set this to your domain in production
# Local development: use localhost:3000 (callbacks won't work, polling will handle it)
# Production: use your actual domain (e.g., https://videofly.app)
# -----------------------------------------------------------------------------
AI_CALLBACK_URL=https://yourdomain.com/api/v1/video/callback
CALLBACK_HMAC_SECRET=generate_random_secret_here

# -----------------------------------------------------------------------------
# Credit & Pricing System (积分与商品配置)
# 所有商品 ID、价格、积分数量统一在 src/config/pricing-user.ts 中管理
# 无需在环境变量中配置
# -----------------------------------------------------------------------------
# Text summary (server only). DeepSeek official API; enable after adding your API key.
# Base URL should include the API version prefix, without /chat/completions.
TEXT_AI_ENABLED=false
TEXT_AI_PROVIDER=deepseek
TEXT_AI_BASE_URL=https://api.deepseek.com
TEXT_AI_MODEL=deepseek-flash
TEXT_AI_API_KEY=
TEXT_AI_TOKEN_FIELD=max_tokens
TEXT_AI_MAX_OUTPUT_TOKENS=2048
TEXT_AI_TIMEOUT_MS=60000
TEXT_SUMMARY_CREDITS=1

# Durable local text-to-video workflow (Kie). KIE_API_KEY is declared above.
VIDEO_AI_ENABLED=false
VIDEO_AI_PROVIDER=kie
VIDEO_AI_BASE_URL=https://api.kie.ai
VIDEO_AI_MODEL=wan/2-7-text-to-video
# Site credits, independent from Kie account billing. Fixed 5s / 1080p / one result.
VIDEO_GENERATION_CREDITS=10


# PayPal sandbox / Waffo Pancake test; keep disabled until configured
PAYPAL_ENABLED=false
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
PAYPAL_WEBHOOK_ID=
# Populated by the optional local sandbox tunnel helper
PAYPAL_WEBHOOK_URL=
WAFFO_ENABLED=false
WAFFO_ENVIRONMENT=test
WAFFO_MERCHANT_ID=
WAFFO_STORE_ID=
WAFFO_PRIVATE_KEY=
WAFFO_WEBHOOK_PUBLIC_KEY=
WAFFO_PRODUCT_STARTER=
WAFFO_PRODUCT_STANDARD=
PAYMENT_RETURN_BASE_URL=

# Optional local sandbox acceptance only; never used for live payments
PAYPAL_SANDBOX_BUYER_EMAIL=
PAYPAL_SANDBOX_BUYER_PASSWORD=

WAFFO_RETURN_BASE_URL=

WAFFO_WEBHOOK_URL=

# AUD-004 unified billing: disabled until test-account acceptance.
# Stripe subscription values are Price IDs; Creem values are Product IDs.
STRIPE_ENABLED=false
STRIPE_ENVIRONMENT=test
STRIPE_ACCOUNT_ID=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_STANDARD=
CREEM_ENABLED=false
CREEM_ENVIRONMENT=test
CREEM_ACCOUNT_SCOPE=your-site-creem-test
CREEM_PRODUCT_STARTER=
CREEM_PRODUCT_STANDARD=
STRIPE_SUB_BASIC_MONTHLY=
STRIPE_SUB_BASIC_YEARLY=
STRIPE_SUB_PRO_MONTHLY=
STRIPE_SUB_PRO_YEARLY=
STRIPE_SUB_ULTIMATE_MONTHLY=
STRIPE_SUB_ULTIMATE_YEARLY=
CREEM_SUB_BASIC_MONTHLY=
CREEM_SUB_BASIC_YEARLY=
CREEM_SUB_PRO_MONTHLY=
CREEM_SUB_PRO_YEARLY=
CREEM_SUB_ULTIMATE_MONTHLY=
CREEM_SUB_ULTIMATE_YEARLY=
